{
  "expo": {
    "name": "Daily Organizer",
    "slug": "daily-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "scheme": "dailyorganizer",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#3D6355"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.dailyorganizer",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
